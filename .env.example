# Copy this file to .env.local and fill in your real values, OR set these as
# GitHub Actions / Pages build environment variables.

# The deployed Google Apps Script Web App URL.
# IMPORTANT: leave empty to run in demo mode with sample data.
VITE_WEB_APP_URL=

# true = use bundled sample data (no backend needed). false = connect to backend.
VITE_USE_MOCK=true
